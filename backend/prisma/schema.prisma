datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  LAB_TECH
  PHARMACIST
  PATIENT
  CAREGIVER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  WALK_IN
  ONLINE
  EMERGENCY
  FOLLOW_UP
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
  CRITICAL
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum LabTestStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  BANK_TRANSFER
}

enum TelemedicineStatus {
  WAITING_ROOM
  IN_CALL
  COMPLETED
  CANCELLED
}

enum CaregiverRelation {
  SPOUSE
  PARENT
  CHILD
  GUARDIAN
  SIBLING
  FAMILY
  OTHER
}

// --------------------------------------------------------
// TENANT & CORE MODULES
// --------------------------------------------------------

model Hospital {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  address         String
  city            String
  state           String
  zipCode         String
  phone           String
  email           String
  licenseNumber   String
  taxId           String?
  logoUrl         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  departments     Department[]
  doctors         Doctor[]
  patients        Patient[]
  appointments    Appointment[]
  admissions      Admission[]
  wards           Ward[]
  beds            Bed[]
  medicines       Medicine[]
  labTests        LabTest[]
  invoices        Invoice[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  teleSessions    TelemedicineSession[]
  chatMessages    ChatMessage[]
  aciSessions     ACISession[]
}

model Department {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors     Doctor[]

  @@unique([hospitalId, code])
}

model Role {
  id          String   @id @default(uuid())
  name        UserRole @unique
  description String?
  users       User[]
}

model User {
  id              String    @id @default(uuid())
  hospitalId      String
  roleId          String
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isEmailVerified Boolean   @default(false)
  isTwoFactorAuth Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])
  doctor          Doctor?
  patient         Patient?
  auditLogs       AuditLog[]
  notifications   Notification[]
  sentMessages    ChatMessage[] @relation("SentMessages")
}

model Doctor {
  id             String     @id @default(uuid())
  hospitalId     String
  userId         String     @unique
  departmentId   String
  specialization String
  qualification  String
  licenseNumber  String
  consultationFee Decimal   @db.Decimal(10, 2)
  availability   Json?
  isAvailable    Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  hospital       Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department @relation(fields: [departmentId], references: [id])
  appointments   Appointment[]
  prescriptions  Prescription[]
  diagnoses      Diagnosis[]
  admissions     Admission[]
  teleSessions   TelemedicineSession[]
  aciSessions    ACISession[]
}

model Patient {
  id                String   @id @default(uuid())
  hospitalId        String
  userId            String?  @unique
  mrn               String
  firstName         String
  lastName          String
  gender            Gender
  dob               DateTime
  bloodGroup        String?
  phone             String
  email             String?
  address           String?
  emergencyContact  String?
  emergencyPhone    String?
  allergies         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  medicalHistory    MedicalHistory[]
  vitals            Vital[]
  appointments      Appointment[]
  admissions        Admission[]
  prescriptions     Prescription[]
  labReports        LabReport[]
  invoices          Invoice[]
  insurance         Insurance[]

  // Phase 2 Relations
  caregivers        CaregiverLink[] @relation("PatientCaregivers")
  teleSessions      TelemedicineSession[]
  recoveryLogs      RecoveryLog[]
  medAdherences     MedicationAdherence[]
  wearableMetrics   WearableMetric[]
  digitalForms      DigitalForm[]
  aiChatHistory     AIChatHistory[]

  // Phase 3 Relations
  aciSessions       ACISession[]
  cdssAlerts        CDSSAlert[]
  predictiveRisks   PredictiveRiskModel[]
  woundTracks       WoundImageTrack[]

  @@unique([hospitalId, mrn])
}

// --------------------------------------------------------
// CLINICAL & EMR MODULES
// --------------------------------------------------------

model MedicalHistory {
  id             String   @id @default(uuid())
  patientId      String
  condition      String
  diagnosisDate  DateTime?
  status         String
  notes          String?
  createdAt      DateTime @default(now())

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Vital {
  id                  String   @id @default(uuid())
  patientId           String
  systolicBp          Int?
  diastolicBp         Int?
  heartRate           Int?
  temperature         Decimal? @db.Decimal(4, 1)
  spO2                Int?
  respiratoryRate     Int?
  weight              Decimal? @db.Decimal(5, 2)
  height              Decimal? @db.Decimal(5, 2)
  recordedAt          DateTime @default(now())
  recordedByUserId    String?

  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String            @id @default(uuid())
  hospitalId      String
  patientId       String
  doctorId        String
  appointmentDate DateTime
  tokenNumber     Int
  status          AppointmentStatus @default(SCHEDULED)
  type            AppointmentType   @default(WALK_IN)
  reason          String?
  qrCodeUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  diagnosis       Diagnosis?
  prescription    Prescription?
  invoices        Invoice[]
  teleSession     TelemedicineSession?
  aciSession      ACISession?
}

model Diagnosis {
  id             String   @id @default(uuid())
  appointmentId String   @unique
  doctorId       String
  icdCode        String?
  symptoms       String
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  clinicalNotes  String?
  createdAt      DateTime @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor         Doctor      @relation(fields: [doctorId], references: [id])
}

model Prescription {
  id             String             @id @default(uuid())
  appointmentId String?            @unique
  patientId      String
  doctorId       String
  status         PrescriptionStatus @default(PENDING)
  notes          String?
  issuedAt       DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])
  doctor         Doctor             @relation(fields: [doctorId], references: [id])
  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  durationDays   Int
  instructions   String?
  dispensedQty   Int          @default(0)

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

// --------------------------------------------------------
// WARDS & ADMISSIONS MODULE
// --------------------------------------------------------

model Ward {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  type        String
  capacity    Int
  createdAt   DateTime @default(now())

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  beds        Bed[]
}

model Bed {
  id          String    @id @default(uuid())
  hospitalId  String
  wardId      String
  bedNumber   String
  status      BedStatus @default(AVAILABLE)
  dailyCharge Decimal   @db.Decimal(10, 2)

  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward        Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions  Admission[]

  @@unique([wardId, bedNumber])
}

model Admission {
  id             String          @id @default(uuid())
  hospitalId     String
  patientId      String
  bedId          String
  doctorId       String
  status         AdmissionStatus @default(ADMITTED)
  admittedAt     DateTime        @default(now())
  dischargedAt   DateTime?
  dischargeNotes String?
  totalAmount    Decimal?        @db.Decimal(10, 2)

  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id])
  bed            Bed             @relation(fields: [bedId], references: [id])
  doctor         Doctor          @relation(fields: [doctorId], references: [id])
}

// --------------------------------------------------------
// PHARMACY & INVENTORY MODULE
// --------------------------------------------------------

model Medicine {
  id                String             @id @default(uuid())
  hospitalId        String
  name              String
  genericName       String?
  category          String
  manufacturer      String?
  unitPrice         Decimal            @db.Decimal(10, 2)
  stockQuantity     Int                @default(0)
  reorderLevel      Int                @default(20)
  expiryDate        DateTime
  batchNumber       String
  barcode           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]

  @@unique([hospitalId, batchNumber])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String
  email       String?
  address     String?
  createdAt   DateTime @default(now())
}

// --------------------------------------------------------
// LABORATORY & RADIOLOGY MODULE
// --------------------------------------------------------

model LabTest {
  id          String      @id @default(uuid())
  hospitalId  String
  name        String
  code        String
  category    String
  price       Decimal     @db.Decimal(10, 2)
  normalRange String?
  unit        String?
  createdAt   DateTime    @default(now())

  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reports     LabReport[]
}

model LabReport {
  id              String        @id @default(uuid())
  patientId       String
  labTestId       String
  status          LabTestStatus @default(PENDING)
  resultValue     String?
  resultNotes     String?
  attachmentUrl   String?
  technicianName  String?
  requestedAt     DateTime      @default(now())
  completedAt     DateTime?

  patient         Patient       @relation(fields: [patientId], references: [id])
  labTest         LabTest       @relation(fields: [labTestId], references: [id])
}

// --------------------------------------------------------
// BILLING, PAYMENTS & INSURANCE MODULE
// --------------------------------------------------------

model Invoice {
  id              String        @id @default(uuid())
  hospitalId      String
  patientId       String
  appointmentId  String?
  invoiceNumber   String        @unique
  totalAmount     Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  netAmount       Decimal       @db.Decimal(10, 2)
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime
  createdAt       DateTime      @default(now())

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id])
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  transactionId String?
  paidAt        DateTime      @default(now())

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Insurance {
  id             String   @id @default(uuid())
  patientId      String
  providerName   String
  policyNumber   String
  coverageAmount Decimal  @db.Decimal(10, 2)
  expiryDate     DateTime
  createdAt      DateTime @default(now())

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// --------------------------------------------------------

model Notification {
  id          String   @id @default(uuid())
  hospitalId  String
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  hospitalId  String
  userId      String?
  action      String
  module      String
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now())

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// --------------------------------------------------------
// PHASE 2 EXTENSIONS: PATIENT ENGAGEMENT & TELEMEDICINE
// --------------------------------------------------------

model TelemedicineSession {
  id             String             @id @default(uuid())
  hospitalId     String
  appointmentId  String             @unique
  patientId      String
  doctorId       String
  roomName       String             @unique
  status         TelemedicineStatus @default(WAITING_ROOM)
  queuePosition  Int                @default(1)
  startedAt      DateTime?
  endedAt        DateTime?
  recordingUrl   String?
  createdAt      DateTime           @default(now())

  hospital       Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient        Patient            @relation(fields: [patientId], references: [id])
  doctor         Doctor             @relation(fields: [doctorId], references: [id])
}

model RecoveryLog {
  id            String   @id @default(uuid())
  patientId     String
  logDate       DateTime @default(now())
  painScore     Int
  moodScore     String
  sleepHours    Decimal  @db.Decimal(3, 1)
  waterIntakeMl Int
  exercisesDone Boolean  @default(false)
  doctorNotes   String?
  createdAt     DateTime @default(now())

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MedicationAdherence {
  id             String   @id @default(uuid())
  patientId      String
  medicineName   String
  scheduledTime  DateTime
  takenTime      DateTime?
  isTaken        Boolean  @default(false)
  isMissed       Boolean  @default(false)
  refillRequested Boolean @default(false)
  createdAt      DateTime @default(now())

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model CaregiverLink {
  id          String            @id @default(uuid())
  patientId   String
  caregiverId String
  relationship CaregiverRelation @default(FAMILY)
  accessLevel String            @default("FULL_ACCESS")
  createdAt   DateTime          @default(now())

  patient     Patient           @relation("PatientCaregivers", fields: [patientId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(uuid())
  hospitalId  String
  senderId    String
  receiverId  String
  content     String
  mediaUrl    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model WearableMetric {
  id              String   @id @default(uuid())
  patientId       String
  provider        String
  steps           Int      @default(0)
  restingHeartRate Int?
  sleepMinutes    Int?
  caloriesBurned  Int?
  spO2Avg         Int?
  syncedAt        DateTime @default(now())

  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DigitalForm {
  id          String   @id @default(uuid())
  patientId   String
  formType    String
  title       String
  formData    Json
  signatureUrl String?
  isSubmitted Boolean  @default(true)
  submittedAt DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model AIChatHistory {
  id            String   @id @default(uuid())
  patientId     String
  query         String
  response      String
  sourceContext String?
  escalated     Boolean  @default(false)
  createdAt     DateTime @default(now())

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// PHASE 3 EXTENSIONS: AMBIENT CLINICAL INTELLIGENCE
// --------------------------------------------------------

model ACISession {
  id                String   @id @default(uuid())
  hospitalId        String
  appointmentId    String   @unique
  doctorId          String
  patientId         String
  audioStreamUrl    String?
  rawTranscript     String?
  diarizedTranscript Json?
  extractedEntities Json?
  isSigned          Boolean  @default(false)
  signedAt          DateTime?
  createdAt         DateTime @default(now())

  hospital          Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor            Doctor      @relation(fields: [doctorId], references: [id])
  patient           Patient     @relation(fields: [patientId], references: [id])
  noteDraft         ClinicalNoteDraft?
  codingSuggestions CodingSuggestion[]
}

model ClinicalNoteDraft {
  id             String   @id @default(uuid())
  aciSessionId   String   @unique
  noteType       String   @default("SOAP") // SOAP, HPI, DISCHARGE_SUMMARY, OPERATIVE
  chiefComplaint String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  fullMarkdown   String
  doctorApproved Boolean  @default(false)
  createdAt      DateTime @default(now())

  aciSession     ACISession @relation(fields: [aciSessionId], references: [id], onDelete: Cascade)
}

model CodingSuggestion {
  id           String   @id @default(uuid())
  aciSessionId String
  codeSystem   String   // ICD-10, ICD-11, CPT, SNOMED, LOINC
  code         String
  description  String
  confidence   Decimal  @db.Decimal(5, 4) // e.g. 0.9450
  evidence     String
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  aciSession   ACISession @relation(fields: [aciSessionId], references: [id], onDelete: Cascade)
}

model CDSSAlert {
  id           String   @id @default(uuid())
  patientId    String
  alertType    String   // DRUG_INTERACTION, ALLERGY_WARNING, ABNORMAL_LAB, SEVERE_RISK
  title        String
  description  String
  severity     String   // CRITICAL, WARNING, INFO
  confidence   Decimal  @db.Decimal(5, 4)
  evidence     String
  isDismissed  Boolean  @default(false)
  createdAt    DateTime @default(now())

  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PredictiveRiskModel {
  id                 String   @id @default(uuid())
  patientId          String
  modelName          String   // SEPSIS_RISK, READMISSION_RISK, ICU_DETERIORATION
  riskScore          Decimal  @db.Decimal(5, 2) // e.g. 84.50 %
  riskCategory       String   // HIGH, MODERATE, LOW
  shapFeatureFactors Json     // {"bp": "+15%", "white_cell": "+30%"}
  calculatedAt       DateTime @default(now())

  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model WoundImageTrack {
  id            String   @id @default(uuid())
  patientId     String
  imageUrl      String
  areaCm2       Decimal  @db.Decimal(6, 2)
  healingStatus String   // IMPROVING, STABLE, DETERIORATING
  aiAnalysis    Json?
  recordedAt    DateTime @default(now())

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
