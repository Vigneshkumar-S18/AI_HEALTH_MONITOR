# MedFlow AI Phase 1 Environment Variables

# Backend Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL & Prisma)
DATABASE_URL="postgresql://medflow_user:medflow_password@localhost:5432/medflow_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super_secret_medflow_jwt_key_2026_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super_secret_medflow_refresh_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Security
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Cloud Storage (AWS S3 or Cloudinary - Ready for production)
STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="medflow-documents"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000/api/v1"
